# Copy this file to .env and fill in your own values. Never commit .env.
NODE_ENV=development
PORT=5000

# --- Database -------------------------------------------------------------
# Local MongoDB (MongoDB Community Server / Compass). Used if MONGODB_URI is empty
# (outside production).
MONGODB_URI=mongodb://127.0.0.1:27017/bail_reckoner

# Or MongoDB Atlas (cloud). In Atlas: Connect -> Drivers -> copy the string, then
#   - put the database name (/bail_reckoner) before the "?" or the data goes to "test"
#   - URL-encode special characters in the password (@ -> %40, # -> %23, / -> %2F)
#   - Network Access must allow your IP (and 0.0.0.0/0 for Render)
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bail_reckoner?retryWrites=true&w=majority

# --- Security -------------------------------------------------------------
# Any long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# Admin account created automatically on first run (password: 8+ characters with a number).
# Change the password after the first login.
ADMIN_EMAIL=admin@bailreckoner.local
ADMIN_PASSWORD=Admin@12345
